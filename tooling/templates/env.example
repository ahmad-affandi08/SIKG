# Templat .env.example (salin ke akar proyek). Jangan mengisi rahasia nyata di berkas ini.
APP_NAME="SIKG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=UTC
CLINIC_TIMEZONE=Asia/Jakarta

# Log harian dengan retensi 90 hari (PRD bagian 17); tanpa PHI.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=90
LOG_LEVEL=info

# Profil hosting (docs/rules/hosting.md): shared atau server. Hanya mengubah bawaan operasional, bukan aturan domain.
SIKG_HOSTING_PROFILE=shared
# Pada profil shared, berkas klinis dienkripsi di aplikasi (disk tidak dienkripsi pengguna).
SIKG_ENCRYPT_FILES=true
# Token untuk endpoint /health (umur denyut cron dan antrean, tanpa PHI). Isi per lingkungan.
HEALTH_TOKEN=
# Ukuran potongan untuk impor/ekspor Excel dan laporan berat (job pendek, batas waktu hosting).
SIKG_CHUNK_SIZE=500

# MySQL (compose.yaml untuk lokal). Dilarang SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sikg
DB_USERNAME=sikg
DB_PASSWORD=

# Bawaan jalan di shared hosting (M21): sesi, cache, dan antrean lewat database; antrean digerakkan cron.
# Redis hanya boleh diaktifkan di .env lingkungan Profil A, bukan di berkas contoh ini.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=private
PULSE_ENABLED=false

# Kunci HMAC untuk blind index NIK dan nomor HP (isi per lingkungan, jangan di-commit)
PII_HASH_KEY=

# Pelacak galat (dengan scrubbing PHI)
SENTRY_LARAVEL_DSN=
