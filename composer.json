{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sikg/sikg",
    "type": "project",
    "description": "Sistem Informasi Klinik Gigi (SIKG).",
    "keywords": ["sikg", "klinik-gigi", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^4.0",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Src\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": "vendor/bin/pest --compact",
        "test:shared": "scripts/verify.sh --shared-only",
        "guard": "python3 scripts/guard.py",
        "verify": "scripts/verify.sh",
        "stan": "vendor/bin/phpstan analyse -c tooling/phpstan.neon --memory-limit=1G --no-progress",
        "arch": "vendor/bin/deptrac analyse --config-file=tooling/deptrac.yaml --no-progress",
        "lint": "vendor/bin/pint --config tooling/pint.json",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
